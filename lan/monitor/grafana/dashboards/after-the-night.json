    {
      "id": 7,
      "type": "state-timeline",
      "title": "The server over the evening",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max_over_time((max(\n  label_replace((max(max_over_time(brieltje_tick_seconds{stat=\"p99\"}[10s])) > bool 0.03) + (max(max_over_time(brieltje_tick_seconds{stat=\"p99\"}[10s])) > bool 0.045), \"part\", \"tick\", \"\", \"\")\n  or label_replace((max(max_over_time(brieltje_event_loop_delay_seconds{stat=\"p99\"}[10s])) > bool 0.05) + (max(max_over_time(brieltje_event_loop_delay_seconds{stat=\"p99\"}[10s])) > bool 0.1), \"part\", \"loop\", \"\", \"\")\n  or label_replace(3 * (1 - max(up{job=\"game\"})), \"part\", \"up\", \"\", \"\")\n))[1m:10s])",
          "legendFormat": "server",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "All good",
                  "color": "#73BF69",
                  "index": 0
                },
                "1": {
                  "text": "Busy",
                  "color": "#FF9830",
                  "index": 1
                },
                "2": {
                  "text": "Slow",
                  "color": "#F2495C",
                  "index": 2
                },
                "3": {
                  "text": "No answer",
                  "color": "#F2495C",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 1
              },
              {
                "color": "#F2495C",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
