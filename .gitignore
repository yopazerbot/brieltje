/images/

# Generated debug images
/data/debug/

# Tooling
/tools/.venv/
# Downloaded command-line tools (tools/ktx2.py fetches the texture encoder here)
/tools/.bin/
# Claude Code's worktrees for background agents
/.claude/worktrees/
__pycache__/
node_modules/
/web/dist/
.vite/

# Editors and OS
.vscode/
.DS_Store
Thumbs.db

# Local multiplayer data (users, login log) when no database is set
/web/.data/

# Plain copies of the private data (sealed into web/private/ by tools/private_data.mjs)
/web/.private/
/web/.sealed.json
# The private companion repository (yopazerbot/brieltje-private): the tools and inputs of the locked homes, checked out here
/private-src/
